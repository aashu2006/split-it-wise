# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
#
#   cp .env.example .env.local          (macOS / Linux)
#   copy .env.example .env.local        (Windows)
#
# Without it the app still runs, signed out, so you can work on the UI — it just
# can't sign in or save anything. `.env.local` is gitignored; never commit it.
#
# All six come from one place: Firebase console -> Project settings (gear icon)
# -> Your apps -> the `firebaseConfig` block. See README step 6.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Turns on App Check (reCAPTCHA v3), which stops anyone who lifts the
# public config above from pointing the SDK at your project. Leave it blank for
# local development — the app behaves identically without it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
