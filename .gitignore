# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Firebase service-account keys, for scripts/ run with admin access. Belt and
# braces: keep the key outside the repo in the first place.
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json

# claude code (local tool settings, not project config)
.claude/

# debug
npm-debug.log*
firestore-debug.log
firebase-debug.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds only variable names and no secrets.
!.env.example

# vercel
.vercel

# agent instruction files regenerated by `next dev` on every run
AGENTS.md
CLAUDE.md
